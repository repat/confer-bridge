# Keep secrets outside source control. Do not paste browser cookies or HAR exports here.
# Copy this file to .env and fill in ONE of the two token options.
#
# Option 1 (recommended): your REST access token; the code fetches the
# model-session token itself via GET /v1/tokens/model. See docs/MODEL_SESSION_TOKEN.md.
# CONFER_ACCESS_TOKEN=
#
# Option 2: a model-session token exported from your authorized session.
# Short-lived; treat like a password. Never commit or log it.
# CONFER_MODEL_SESSION_TOKEN=
#
# ---- Facade server (src/openai/main.ts) ----
# Bearer key your OpenAI clients must present to the facade.
# FACADE_API_KEY=
# Port for the facade HTTP server (default 8080).
# FACADE_PORT=8080
# Set to 1 to expose upstream thinking deltas as reasoning_content (default off).
# FACADE_EXPOSE_THINKING=0

# CONFER_BASE_URL=https://api.confer.to
# CONFER_AUTH_MODE=to-be-determined-from-browser-implementation
