# /etc/confer-bridge.env — secrets for the confer-bridge facade service.
# Copy to /etc/confer-bridge.env, chmod 600, and fill in real values.
# Never commit the filled-in file.

# Your confer.to REST access token ('auth_token' in browser localStorage).
# See docs/MODEL_SESSION_TOKEN.md. Short-lived; refresh when expired.
CONFER_ACCESS_TOKEN=replace-me

# Bearer key your OpenAI clients must present to this facade.
FACADE_API_KEY=replace-me

# Port for the facade HTTP server (default 8080).
# FACADE_PORT=8080

# Set to 1 to expose upstream thinking deltas as reasoning_content.
# FACADE_EXPOSE_THINKING=0
